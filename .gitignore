# —— macOS 垃圾 ——
.DS_Store
._*
__MACOSX/

# —— Java / Gradle 构建产物 ——
build/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# gradle wrapper 的 jar 必须入库，否则别人 clone 下来 ./gradlew 直接失败
!**/gradle/wrapper/gradle-wrapper.jar

# —— Flutter / Dart 构建产物 ——
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties

# —— 依赖目录 ——
node_modules/

# —— 本地配置与密钥 ——
.env
.env.local
local.properties
*.pem
*.key

# —— 编辑器 ——
.vscode/*
!.vscode/extensions.json
.vscode/settings.json
*.swp
*~

# —— 日志与临时文件 ——
*.log
logs/
tmp/
temp/

# —— 本地项目数据，不入库 ——
.workbuddy/

# —— 发布产物：由 scripts/build_release.sh 生成 ——
dist/

# —— Rust 构建产物 ——
shell/rust/target/

# —— 运行时存档 ——
# 服务端默认写 ./world.json。这是玩家自己的世界数据，不属于仓库内容。
world.json
*.corrupt-*
